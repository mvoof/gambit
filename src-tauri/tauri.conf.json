{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Gambit",
  "version": "0.1.0",
  "identifier": "com.voof.gambit",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Gambit",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "decorations": false,
        "resizable": true,
        "fullscreen": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFGQkIwMjNBQkQyNjAxOEMKUldTTUFTYTlPZ0s3cjN3S0xaVE9PT2drL0N2cm92K1AxM3czSkpHVUNhT2ZQZWpaMGl0Q09mVEQK",
      "endpoints": [
        "https://github.com/mvoof/gambit/releases/latest/download/latest.json"
      ]
    }
  }
}
