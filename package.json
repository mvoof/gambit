{
  "name": "gambit",
  "description": "Chess against a real engine, and training",
  "private": true,
  "license": "GPL-3.0-or-later",
  "version": "1.0.0",
  "type": "module",
  "repository": {
    "url": "https://github.com/mvoof/gambit"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json --features dev",
    "tauri:build:dev": "tauri build --config src-tauri/tauri.dev.conf.json --no-sign --features dev",
    "tauri:build:release": "tauri build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --type-aware --fix .",
    "format": "oxfmt --write \"./**/*.{js,jsx,mjs,ts,tsx,json,scss,md}\"",
    "format:check": "oxfmt --check \"./**/*.{js,jsx,mjs,ts,tsx,json,scss,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "contract": "cd src-tauri && cargo test -j 2 --features dev --lib export_bindings",
    "cargo:format": "cd src-tauri && cargo fmt",
    "cargo:lint": "cd src-tauri && cargo clippy --all-targets -- -D warnings",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "i18next": "^26.7.1",
    "lucide-react": "^1.69.0",
    "mobx": "^7.1.4",
    "mobx-react-lite": "^5.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.12",
    "sass": "^1.107.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/react": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2005",
    "storybook": "^10.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.1.0"
  }
}
