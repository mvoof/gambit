{
  "name": "tauri-app-template",
  "description": "Opinionated Tauri 2 + React 19 + TypeScript template",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "repository": {
    "url": "https://github.com/mvoof/tauri-app-template"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build:dev": "tauri build --config src-tauri/tauri.dev.conf.json --no-sign",
    "tauri:build:release": "tauri build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --type-aware --fix .",
    "format": "oxfmt --write \"./**/*.{js,jsx,mjs,ts,tsx,json,scss,md}\"",
    "format:check": "oxfmt --check \"./**/*.{js,jsx,mjs,ts,tsx,json,scss,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "cargo:format": "cd src-tauri && cargo fmt",
    "cargo:lint": "cd src-tauri && cargo clippy --all-targets -- -D warnings",
    "rename": "node scripts/rename-app.mjs",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "i18next": "^25.6.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^16.1.1",
    "sass": "^1.98.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.3.5",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/react": "^10.3.5",
    "@storybook/react-vite": "^10.3.5",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^25.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "lefthook": "^2.1.9",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "storybook": "^10.3.5",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^4.1.4"
  }
}
